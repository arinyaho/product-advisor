[Unit]
Description=Index completed Notion and Drive captures through the company MCP
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/services/company-context
UMask=0077
ExecStart=%h/services/company-context/.venv/bin/python -m company_context.document_sync sync --state-dir %h/.local/share/company-context
TimeoutStartSec=infinity
StandardOutput=append:%h/.local/share/company-context/document-sync.log
StandardError=inherit
